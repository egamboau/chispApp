pipeline {
  agent { label 'base' }

  environment {
    BACKUP_IMAGE = 'nas-server.local:5000/jupas-app-backup:latest'
  }

  options {
    disableConcurrentBuilds()
    withFolderProperties()
  }

  triggers {
    cron('TZ=America/Guatemala\n0 0 * * 2')
  }

  stages {
    stage('Backup') {
      steps {
        sh '''
          set -eu
          : "${TOURNAMENT_NODE_ID:?Set TOURNAMENT_NODE_ID in Jenkins}"
          : "${TOURNAMENT_DATA_DIR:?Set TOURNAMENT_DATA_DIR in Jenkins}"
          sh backup/run-swarm-job.sh
        '''
      }
    }
  }
}
