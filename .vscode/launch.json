{
  "version": "0.2.0",
  "configurations": [
    {
      "command": "npm run dev:backend",
      "name": "Start Server",
      "request": "launch",
      "type": "node-terminal",
      "env": {
        "DATABASE_PATH": "${workspaceFolder}/backend/data/tournament.db"
      }
    },
    {
      "command": "npm run dev:frontend",
      "name": "Start Frontend",
      "request": "launch",
      "type": "node-terminal",
      "env": {
        "DATABASE_PATH": "${workspaceFolder}/backend/data/tournament.db"
      }
    }
  ]
}
